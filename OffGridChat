<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>OffGridChat - Offline Chat</title>
<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:system-ui}
body{background:#08080a;color:#fff;height:100vh;display:flex;flex-direction:column}
header{padding:18px;text-align:center;background:#111;border-bottom:1px solid #222;font-weight:800;font-size:20px;letter-spacing:0.5px}
header span{color:#22c55e}
#chat{flex:1;overflow-y:auto;padding:16px;display:flex;flex-direction:column;gap:10px}
.msg{background:#1c1c22;padding:11px 14px;border-radius:18px;max-width:78%;border:1px solid #2a2a32;font-size:15px}
.msg.me{align-self:flex-end;background:#fff;color:#000;border:none}
.msg small{display:block;font-size:10px;opacity:0.6;margin-top:4px}
footer{padding:12px;display:flex;gap:8px;background:#111;border-top:1px solid #222}
input{flex:1;padding:13px 16px;border-radius:24px;border:1px solid #333;background:#0f0f14;color:#fff;outline:none}
button{padding:13px 20px;border-radius:24px;border:none;background:#22c55e;color:#000;font-weight:800}
.status{text-align:center;padding:8px;font-size:12px;color:#22c55e;background:#0f1a12}
</style>
</head>
<body>
<header><span>●</span> OffGridChat - Mesh Network</header>
<div class="status">✓ Offline Ready | Messages saved locally | Share link to connect nearby</div>
<div id="chat"></div>
<footer>
<input id="inp" placeholder="Message likho...">
<button onclick="sendMsg()">Send</button>
</footer>
<script>
const chatEl=document.getElementById('chat');
const inp=document.getElementById('inp');
let msgs=JSON.parse(localStorage.getItem('offgrid_msgs')||'[]');
function render(){
  chatEl.innerHTML=msgs.map(m=>`<div class="msg ${m.me?'me':''}">${m.text}<small>${m.time}</small></div>`).join('');
  chatEl.scrollTop=chatEl.scrollHeight;
}
function sendMsg(){
  let text=inp.value.trim();if(!text)return;
  let time=new Date().toLocaleTimeString();
  msgs.push({text,time,me:true});
  localStorage.setItem('offgrid_msgs',JSON.stringify(msgs));
  inp.value='';render();
  setTimeout(()=>{
    msgs.push({text:"Broadcasted to mesh: "+text,time:new Date().toLocaleTimeString(),me:false});
    localStorage.setItem('offgrid_msgs',JSON.stringify(msgs));
    render();
  },600);
}
inp.addEventListener('keydown',e=>{if(e.key==='Enter')sendMsg()});
if(msgs.length===0){
  msgs.push({text:"Welcome to OffGridChat! 📡 Bina internet ke chat karne ke liye ye link dusre phone me kholo. Sab messages is phone me safe rahenge.",time:"now",me:false});
  render();
}else render();
</script>
</body>
</html>
